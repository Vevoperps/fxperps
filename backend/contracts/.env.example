# Copy to `.env` and fill in. Never commit `.env`.
# Use a throwaway deployer that holds only the gas it needs for the deploy.
#
# Every value below was checked against the chain itself rather than copied
# from a page about it. A confidently wrong address is worse than an empty one.

# --- chain: Robinhood Chain (the mainnet target) ------------------------------
# An Arbitrum Orbit rollup on Ethereum blobs. Block time measured at ~0.101s.
# `evm_version = "paris"` in foundry.toml stays until PUSH0 is confirmed here.
#
#   mainnet  4663    https://rpc.mainnet.chain.robinhood.com
#   testnet  46630   https://rpc.testnet.chain.robinhood.com
#
# The public RPC keeps no archive: state is pruned to roughly the last 6000
# blocks (about ten minutes), while the log index reaches much further back.
# So START_BLOCK for the keeper has to stay near the head, or the deployment
# needs its own node.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# --- deployer ----------------------------------------------------------------
# Foundry reads this with --private-key $DEPLOYER_KEY. It is never printed,
# logged or committed. A fresh wallet, funded with gas and nothing else.
DEPLOYER_KEY=

# --- settlement --------------------------------------------------------------
# The settlement token on the target chain.
#
# Blank is the testnet answer and it is deliberate: the deploy script puts up a
# MockUSDG with an open faucet, six decimals like a real dollar stablecoin, and
# says so loudly in the log. On chain 4663 the script refuses to do that at all,
# because `MockUSDG.mint` takes any address and any amount.
#
# USDG is Robinhood Chain's native stablecoin. The address below was read off
# the chain, not copied: symbol() answers "USDG", decimals() answers 6, and
# totalSupply() answers ~719.8M. Paxos and Robinhood both publish the same one.
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# --- oracle ------------------------------------------------------------------
# Pyth's contract on the target chain. Leave blank and the script deploys a
# MockOracle the keeper writes into, which is a testnet-only arrangement.
#
 Sepolia, verified against the chain
# rather than taken from documentation: it carries code, its
# getValidTimePeriod() answers 60, and getPriceUnsafe() on the USD/JPY feed id
# returns a real price. Blank it to deploy the mock oracle instead, and replace
# it on any other chain.
PYTH_ADDRESS=0x4374e5a8b9C22271E9EB878A2AA31DE97DF15DAF
# Seconds a price may be old before a market stops trading.
#
# Pyth is pull-based: a price only lands on chain when somebody pays to put it
# there. This deployment does not use Pyth at all, so the value here only bounds
# how stale a pushed mark may be before its market stops trading.
ORACLE_MAX_AGE=300
# Widest publisher confidence interval tolerated, in bps of the price.
ORACLE_MAX_CONFIDENCE_BPS=50

# --- explorer ----------------------------------------------------------------
# Robinhood Chain runs Blockscout: https://robinhoodchain.blockscout.com/api
EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api
EXPLORER_API_KEY=
