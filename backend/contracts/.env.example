# Copy to `.env` and fill in. Never commit `.env`.
# Use a throwaway deployer that holds only the gas it needs for the deploy.
#
# Two targets, and they are kept apart on purpose. The Arbitrum Sepolia block
# is filled in because every value in it was checked against the chain itself,
# not copied from a blog post. The Robinhood block is blank because it has not
# been, and a confidently wrong address is worse than an empty one.

# --- chain: Arbitrum Sepolia (the testnet target) -----------------------------
# chainId 421614, confirmed by eth_chainId against the endpoint below.
TESTNET_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
TESTNET_CHAIN_ID=421614

# --- chain: Robinhood Chain (the mainnet target) ------------------------------
# Unconfirmed. Fill both before deploying anything here, and check whether the
# chain carries PUSH0 before touching `evm_version` in foundry.toml.
RPC_URL=
CHAIN_ID=4663

# --- deployer ----------------------------------------------------------------
# Foundry reads this with --private-key $DEPLOYER_KEY. It is never printed,
# logged or committed. A fresh wallet, funded with gas and nothing else.
DEPLOYER_KEY=

# --- settlement --------------------------------------------------------------
# The settlement token on the target chain.
#
# Blank is the testnet answer and it is deliberate: the deploy script puts up a
# MockUSDG with an open faucet, six decimals like a real dollar stablecoin, and
# says so loudly in the log. On Robinhood Chain this must carry the real USDG
# address — the fallback there would be a token anybody can mint.
USDG_ADDRESS=

# --- oracle ------------------------------------------------------------------
# Pyth's contract on the target chain. Leave blank and the script deploys a
# MockOracle the keeper writes into, which is a testnet-only arrangement.
#
# The address below is Pyth on Arbitrum Sepolia, verified against the chain
# rather than taken from documentation: it carries code, its
# getValidTimePeriod() answers 60, and getPriceUnsafe() on the USD/JPY feed id
# returns a real price. Blank it to deploy the mock oracle instead, and replace
# it on any other chain.
PYTH_ADDRESS=0x4374e5a8b9C22271E9EB878A2AA31DE97DF15DAF
# Seconds a price may be old before a market stops trading.
#
# Pyth is pull-based: a price only lands on chain when somebody pays to put it
# there, and on a testnet nobody does. The USD/JPY price sitting on Arbitrum
# Sepolia right now is weeks old, so every market reverts until the keeper's
# price loop is running. That is the correct failure, and it is the reason the
# keeper goes up straight after the deploy rather than later.
ORACLE_MAX_AGE=60
# Widest publisher confidence interval tolerated, in bps of the price.
ORACLE_MAX_CONFIDENCE_BPS=50

# --- explorer ----------------------------------------------------------------
# Arbitrum Sepolia: https://api-sepolia.arbiscan.io/api
EXPLORER_API_URL=
EXPLORER_API_KEY=
