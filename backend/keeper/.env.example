# Copy to `.env` and fill in. Never commit `.env`.
#
# The key below signs nothing but maintenance calls: posting prices and
# liquidating positions. Use a throwaway wallet funded with gas and nothing
# else — never the deployer, and never a wallet that holds funds. Neither
# `poke` nor `liquidate` can move anyone's balance, so a stolen keeper key
# costs you its gas and nothing more, which is the whole point of keeping it
# separate.

# --- chain -------------------------------------------------------------------
# Arbitrum Sepolia, the testnet target:
#   RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
#   CHAIN_ID=421614
RPC_URL=
CHAIN_ID=421614
KEEPER_KEY=

# --- oracle kind ---------------------------------------------------------------
# What the price loop does each round:
#   pyth  fetch Pyth's signed updates and pay the chain to verify them
#   push  fetch conventional FX rates and post them to a PushOracle, where this
#         keeper is the named publisher and decides the mark
#   mock  write parsed Pyth prices into a MockOracle
# Left blank it is inferred: pyth when PYTH_ADDRESS is set, mock when it is not.
ORACLE_KIND=

# The rate source behind ORACLE_KIND=push, quoted base=USD. It signs nothing.
FX_URL=https://api.fxratesapi.com/latest

# How far a rate must move before it is worth a transaction, in bps.
# A pair that has not moved keeps the mark it already has; one ageing past half
# the oracle's staleness window is refreshed whether it moved or not. Sixty-four
# pairs rewritten every round regardless is about a quarter of an ether a day.
MIN_MOVE_BPS=2

# --- contracts ---------------------------------------------------------------
# Both come out of the deploy. `deployments/<chainId>.json` has them, and so
# does the deploy script's own log.
ENGINE_ADDRESS=
ORACLE_ADDRESS=
# Pyth's own contract. Blank means the deployment is using the mock oracle,
# and the price pusher writes into that instead.
#
# Arbitrum Sepolia: 0x4374e5a8b9C22271E9EB878A2AA31DE97DF15DAF
PYTH_ADDRESS=

# --- cadence, in seconds -----------------------------------------------------
PRICE_INTERVAL=15
LIQUIDATION_INTERVAL=20
# The 24h reference mark. The contract refuses to move it more than once a
# day, so this only decides how soon after the window it is refreshed.
SNAPSHOT_INTERVAL=1200
# Block to start scanning for open positions from. The deploy block.
START_BLOCK=0

# --- pyth --------------------------------------------------------------------
# Two endpoints serve the same API. `hermes.pyth.network` is the original;
# `https://pyth.dourolabs.app/hermes` is the upgraded one Pyth now points new
# integrations at. If one answers 403 with a valid key, try the other.
HERMES_URL=https://hermes.pyth.network
# HERMES_URL=https://pyth.dourolabs.app/hermes
# Since 26 August 2026 every hermes.pyth.network request needs a Pyth API key.
# It is free: sign up at https://pythdata.app/signup and paste the key here.
# The on-chain Pyth contracts stay permissionless — only fetching the signed
# prices to push needs this. A deployment running the mock oracle needs none.
PYTH_API_KEY=
