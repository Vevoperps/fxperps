# Line endings are normalised in the repository and checked out native.
#
# The work happens on Windows and CI runs on Linux. Without this, every file
# Windows touches comes back as a whole-file diff, and a Solidity or shell file
# checked in with CRLF fails on the runner for reasons that look like anything
# but line endings.
* text=auto eol=lf

# Binary: never normalised, never diffed as text.
*.png  binary
*.webp binary
*.jpg  binary
*.avif binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.mp4  binary
*.pdf  binary

# Generated. Collapsed in pull requests, and excluded from the language stats
# so the repository does not report itself as mostly vendored Solidity.
backend/shared/abi/*.json         linguist-generated=true
backend/shared/markets.json       linguist-generated=true
backend/contracts/script/MarketTable.sol linguist-generated=true
src/lib/chain/abi.ts              linguist-generated=true
backend/contracts/lib/**          linguist-vendored=true
yarn.lock                         linguist-generated=true
package-lock.json                 linguist-generated=true
